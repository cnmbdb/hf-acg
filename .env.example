# Copy this file to .env and fill in local secrets. Never commit .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demo
DB_USERNAME=demo
DB_PASSWORD=replace-with-local-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=acg_

# Redis is used for PHP sessions and runtime cache. Databases 1 and 2 are kept separate.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TIMEOUT=1.5
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_SESSION_PREFIX=acg_sess:
REDIS_CACHE_PREFIX=acg_cache:

# Cloudflare Tunnel: set true only when a local tunnel is needed.
CFTUN_ENABLED=false
CFTUN_PROTOCOL=quic
CFTUN_ORIGIN_URL=http://127.0.0.1:8080
CFTUN_TUNNEL_ID=
CFTUN_CREDENTIALS_FILE=
CFTUN_PUBLIC_URL=
CFTUN_TOKEN=replace-with-cloudflare-tunnel-token

# ContentCenter uses this server-only token to commit MDX into the configured docs repository.
CONTENT_CENTER_GITHUB_TOKEN=replace-with-fine-grained-github-token
